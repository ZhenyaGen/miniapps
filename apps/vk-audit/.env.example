# Числовой ID мини-приложения с dev.vk.ru. Не секрет: виден в адресной строке
# при любом входе. Доверенный redirect URI в настройках приложения должен
# включать http://localhost:8910/callback — его используют десктопная версия
# и сборка под Android.
VITE_VK_APP_ID=

# Сообщество бота, который присылает разборы в личные сообщения (apps/vk-bot).
# Пусто — блок подписки в отчёте не показывается.
VITE_VK_BOT_GROUP_ID=
