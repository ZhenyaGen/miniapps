# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа.
# Права: сообщения сообщества. Им бот читает Long Poll и пишет людям.
VK_GROUP_TOKEN=

# Числовой ID сообщества (без минуса).
VK_GROUP_ID=

# Сервисный ключ приложения с dev.vk.ru → Разработка → Ключи доступа.
# Им читаются стены: ключом сообщества wall.get недоступен (ошибка 27).
VK_SERVICE_TOKEN=

# Ключ DeepSeek: platform.deepseek.com → API keys. Без него бот работает,
# но присылает сухие факты вместо человеческого разбора.
VK_LLM_KEY=
VK_LLM_BASE=https://api.deepseek.com/v1
VK_LLM_MODEL=deepseek-chat

# Как часто планировщик проверяет, кому пора слать (минуты).
BOT_TICK_MINUTES=15

# Файл с подписками и часовой пояс расчёта.
BOT_STORE=data/subscriptions.json
BOT_TZ_OFFSET=3
